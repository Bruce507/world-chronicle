{
  "name": "world-chronicle",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "寰宇时序 · World Chronicle — a static, map-anchored atlas of world history.",
  "scripts": {
    "build": "node scripts/build-data.mjs",
    "build:all": "npm run build:states && npm run build:coverage && npm run build:entities && npm run build:scenes && npm run build:data && npm run build:chronicles && npm run build:reports",
    "build:states": "python3 scripts/build-state-changes.py",
    "build:coverage": "python3 scripts/build-coverage-events.py",
    "build:chronicles": "python3 scripts/build-chronicles.py",
    "build:historical": "python3 scripts/build-historical.py",
    "build:world": "python3 scripts/build-world-50m.py",
    "validate": "node scripts/validate-data.mjs",
    "serve": "python3 -m http.server 8000",
    "serve:gzip": "node scripts/serve-gzip.mjs 8002",
    "build:world-i18n": "python3 scripts/enrich-world-i18n.py",
    "translate": "python3 scripts/translate-events.py",
    "build:entities": "node scripts/build-historical-entities.mjs",
    "build:reports": "node scripts/build-reports.mjs",
    "build:scenes": "node scripts/build-scene-taxonomy.mjs",
    "smoke": "node scripts/ux-smoke.mjs",
    "content-check": "node scripts/content-check.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "data-qa": "node scripts/data-qa.mjs",
    "perf": "node scripts/perf-probe.mjs",
    "perf:throttle": "node scripts/perf-throttle.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
